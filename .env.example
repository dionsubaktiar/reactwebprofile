# ============================================
# reactwebprofile — Environment Configuration
# ============================================

# Base URL untuk API Backend (Laravel) — tanpa trailing slash
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Base URL untuk CSRF Cookie (Laravel Sanctum)
NEXT_PUBLIC_SANCTUM_URL=http://localhost:8000

# (Opsional) OAuth Callback URL
NEXT_PUBLIC_OAUTH_CALLBACK_URL=http://localhost:3000/auth-crud/callback

# (Opsional) App Environment
NEXT_PUBLIC_APP_ENV=development